# 统一行尾: 仓库内存 LF, 检出时按平台自动转换
# 不加这个文件, Windows 克隆出来的工作区是 CRLF, 与源目录逐字节比对会"看起来全都不一样"
* text=auto eol=lf

# 例外: Windows 批处理与 PowerShell 脚本必须是 CRLF
#   .bat 若为纯 LF, cmd.exe 解析 goto/label 会出问题
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# shell 脚本必须 LF (带 BOM/CRLF 会报 bad interpreter)
*.sh text eol=lf

# 明确二进制, 避免被当文本处理
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.onnx binary
*.gguf binary
*.zip binary
*.pdf binary
*.exe binary
*.dll binary
